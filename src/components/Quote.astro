---
interface Props {
  isEs?: boolean;
}
const { isEs = false } = Astro.props;
---

<section class="py-6 md:py-8 bg-gradient-to-b from-white to-slate-100 relative min-h-svh flex flex-col justify-center" id="quote">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="text-center mb-4 md:mb-6 reveal">
            <span class="stencil-text text-accent mb-2 block">{isEs ? 'Inicia Operaciones' : 'Start Operations'}</span>
            <h2 class="text-3xl md:text-4xl font-bold font-display">{isEs ? 'Solicitar Cotización' : 'Request a Quote'}</h2>
        </div>

        <form action="https://api.web3forms.com/submit" method="POST" class="space-y-4 glass p-4 sm:p-5 md:p-6 rounded-2xl md:rounded-3xl border border-slate-200 shadow-xl reveal">
            
            <input type="hidden" name="access_key" value="6df574a6-1e89-4ea3-8ffd-bb669abc9624">
            <input type="hidden" name="subject" value="Quote request — Premier Warehouse" />
            <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-10">
                <div class="space-y-3">
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">{isEs ? 'Nombre Completo' : 'Full Name'}</label>
                        <input required type="text" name="full_name" autocomplete="name" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" />
                    </div>
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">{isEs ? 'Correo Electrónico' : 'Email'}</label>
                        <input required type="email" name="contact_email" autocomplete="email" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" />
                    </div>
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">{isEs ? 'Teléfono' : 'Phone'}</label>
                        <input required type="tel" name="contact_phone" inputmode="tel" autocomplete="tel" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" />
                    </div>
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide"><span>{isEs ? 'Origen del Envío' : 'Shipping From'}</span> <span class="opt-tag text-slate-400">{isEs ? '(opcional)' : '(optional)'}</span></label>
                        <input type="text" name="shipping_from" autocomplete="address-level2" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" />
                    </div>
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide"><span>{isEs ? 'País de Destino' : 'Destination Country'}</span> <span class="opt-tag text-slate-400">{isEs ? '(opcional)' : '(optional)'}</span></label>
                        <input type="text" name="destination_country" autocomplete="country-name" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" />
                    </div>
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide"><span>{isEs ? 'Ciudad / Región' : 'Town/City/Region'}</span> <span class="opt-tag text-slate-400">{isEs ? '(opcional)' : '(optional)'}</span></label>
                        <input type="text" name="destination_city" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" />
                    </div>
                </div>

                <div class="space-y-3">
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">{isEs ? 'Servicio Principal' : 'Main Service'}</label>
                        <select required name="service_type" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent appearance-none">
                            <option value="" disabled selected>{isEs ? 'Seleccionar...' : 'Select...'}</option>
                            <option value="storage">{isEs ? 'Almacenaje ($15/pallet/mes)' : 'Storage ($15/pallet/mo)'}</option>
                            <option value="transload">Transload</option>
                            <option value="crossdock">Cross Dock</option>
                            <option value="pickpack">Pick & Pack</option>
                            <option value="other">{isEs ? 'Otro' : 'Other'}</option>
                        </select>
                    </div>
                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">{isEs ? 'Volumen Estimado' : 'Estimated Volume'}</label>
                        <input required type="number" name="volume_pallets" min="1" placeholder="Ex: 20" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all" />
                    </div>
                    <div class="relative" id="frequency-group">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">{isEs ? 'Duración / Frecuencia' : 'Duration / Frequency'}</label>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                            <label class="cursor-pointer">
                                <input type="radio" name="frequency" class="peer sr-only" value="one_time" required />
                                <div class="text-center px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent font-bold transition-all hover:border-slate-300">{isEs ? 'Única vez' : 'One-time'}</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="frequency" class="peer sr-only" value="daily" />
                                <div class="text-center px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent font-bold transition-all hover:border-slate-300">{isEs ? 'Diario' : 'Daily'}</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="frequency" class="peer sr-only" value="weekly" />
                                <div class="text-center px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent font-bold transition-all hover:border-slate-300">{isEs ? 'Semanal' : 'Weekly'}</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="frequency" class="peer sr-only" value="monthly" />
                                <div class="text-center px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent font-bold transition-all hover:border-slate-300">{isEs ? 'Mensual' : 'Monthly'}</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="frequency" class="peer sr-only" value="yearly" />
                                <div class="text-center px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent font-bold transition-all hover:border-slate-300">{isEs ? 'Anual' : 'Yearly'}</div>
                            </label>
                        </div>
                    </div>

                    <div class="relative hidden" id="turnaround-group">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">{isEs ? 'Tiempo de Entrega' : 'Turnaround'}</label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <label class="cursor-pointer">
                                <input type="radio" name="turnaround" class="peer sr-only" value="same_day" />
                                <div class="text-center px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent font-bold transition-all hover:border-slate-300">{isEs ? 'Mismo Día ($9.00)' : 'Same Day ($9.00)'}</div>
                            </label>
                            <label class="cursor-pointer">
                                <input type="radio" name="turnaround" class="peer sr-only" value="next_day" />
                                <div class="text-center px-4 py-3 bg-slate-50 border border-slate-200 rounded-xl peer-checked:bg-accent peer-checked:text-white peer-checked:border-accent font-bold transition-all hover:border-slate-300">{isEs ? 'Día Siguiente ($10.50)' : 'Next Day ($10.50)'}</div>
                            </label>
                        </div>
                    </div>

                    <div class="relative">
                        <label class="block text-sm font-bold text-slate-700 mb-2 uppercase tracking-wide">{isEs ? 'Información del envío (opcional)' : 'Shipment details (optional)'}</label>
                        <textarea name="shipment_details" rows="3" placeholder="e.g. 20 pallets from China to MIA — transload same-day…" class="w-full bg-slate-50 border border-slate-200 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-accent focus:border-transparent transition-all resize-y"></textarea>
                    </div>
                </div>
            </div>

            <div class="pt-2">
                <button id="quote-submit-btn" type="submit" class="w-full bg-primary hover:bg-slate-800 text-white font-bold py-4 rounded-xl flex items-center justify-center gap-3 transition-all group">
                    <span class="btn-text">{isEs ? 'Enviar Solicitud' : 'Submit Request'}</span>
                    <i data-lucide="send" class="w-5 h-5 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform"></i>
                </button>
                <p class="text-center text-sm text-slate-500 mt-3 font-medium">{isEs ? 'Puntuales y rápidos: respuesta y preparación ágiles.' : 'On-time, quick turnaround — prompt reply and preparation.'}</p>
                <p class="text-center text-xs text-slate-400 mt-2">{isEs ? 'Las tarifas publicadas son estimaciones de referencia y pueden variar. Tu cotización final será confirmada por nuestro equipo logístico.' : 'Published rates are reference estimates and may vary. Your final quote is confirmed by our logistics team.'}</p>
            </div>
        </form>
    </div>
</section>