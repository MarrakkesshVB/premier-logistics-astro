---
interface Props {
  isEs?: boolean;
}
const { isEs = false } = Astro.props;
---

<section id="rates" class="py-10 md:py-12 bg-white relative min-h-svh flex flex-col justify-center">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="mb-8 md:mb-10 reveal">
            <span class="stencil-text text-slate-400 mb-2 block">{isEs ? 'Precios Transparentes' : 'Transparent Pricing'}</span>
            <h2 class="text-3xl md:text-4xl font-bold font-display">{isEs ? 'Tarifas Oficiales' : 'Official Rate Board'}</h2>
            <p class="mt-3 text-base md:text-lg text-slate-600 max-w-2xl">
                {isEs ? 'Tarifas accesibles y entrega puntual. Cargos de Aduana exentos para importadores.' : 'Affordable rates & on-time delivery. Customs Clearance Fees waived for importers.'}
            </p>
            <p class="mt-2 text-xs text-slate-400">{isEs ? 'Tarifas de referencia — pueden variar según volumen y temporada. Cotización final confirmada por nuestro equipo.' : 'Reference rates — may vary by volume and season. Final quote confirmed by our team.'}</p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-4 md:gap-5">
            <!-- Fila 1: Storage -->
            <div class="lg:col-span-2 h-full border border-slate-200 rounded-2xl p-5 md:p-6 bg-slate-50 hover:bg-white hover:shadow-xl transition-all duration-500 hover:-translate-y-1 relative overflow-hidden group/card flex flex-col justify-between reveal reveal-delay-100">
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="stencil-text text-accent">{isEs ? 'ALMACENAJE' : 'STORAGE'}</span>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold mb-2 font-display">{isEs ? 'Almacenaje' : 'Storage'}</h3>
                    <p class="text-slate-600 text-sm mb-4">{isEs ? 'Tarifa estándar de almacenamiento' : 'Standard storage rate'}</p>
                </div>
                <div>
                    <div class="flex items-baseline gap-2 mb-4 border-t border-slate-200 pt-4">
                        <span class="text-3xl md:text-4xl font-bold font-mono text-primary">$15.00</span>
                        <span class="text-slate-500 font-medium">{isEs ? '/pallet/mes' : '/pallet/mo'}</span>
                    </div>
                    <a href="#quote" class="w-full py-3 rounded-xl border-2 border-slate-200 hover:border-accent hover:bg-accent hover:text-white transition-colors font-bold flex items-center justify-center gap-2 group/btn">
                        {isEs ? 'Solicitar' : 'Request'} <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </div>

            <!-- Fila 1: Pick & Pack -->
            <div class="lg:col-span-2 h-full border border-slate-200 rounded-2xl p-5 md:p-6 bg-slate-50 hover:bg-white hover:shadow-xl transition-all duration-500 hover:-translate-y-1 relative overflow-hidden group/card flex flex-col justify-between reveal reveal-delay-200">
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="stencil-text text-accent">FULFILLMENT</span>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold mb-2 font-display">Pick & Pack</h3>
                    <p class="text-slate-600 text-sm mb-4">{isEs ? 'Preparación de pedidos E-commerce' : 'E-commerce order fulfillment'}</p>
                </div>
                <div>
                    <div class="flex items-baseline gap-2 mb-4 border-t border-slate-200 pt-4">
                        <span class="text-3xl md:text-4xl font-bold font-mono text-primary">$10.00</span>
                        <span class="text-slate-500 font-medium">/pallet</span>
                    </div>
                    <a href="#quote" class="w-full py-3 rounded-xl border-2 border-slate-200 hover:border-accent hover:bg-accent hover:text-white transition-colors font-bold flex items-center justify-center gap-2 group/btn">
                        {isEs ? 'Solicitar' : 'Request'} <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </div>

            <!-- Fila 1: Cross Dock -->
            <div class="lg:col-span-2 h-full border border-slate-200 rounded-2xl p-5 md:p-6 bg-slate-50 hover:bg-white hover:shadow-xl transition-all duration-500 hover:-translate-y-1 relative overflow-hidden group/card flex flex-col justify-between reveal reveal-delay-300">
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="stencil-text text-accent">{isEs ? 'RECEPCIÓN' : 'RECEIVING'}</span>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold mb-2 font-display">Cross Dock</h3>
                    <p class="text-slate-600 text-sm mb-4">{isEs ? 'Recepción y despacho inmediato' : 'Immediate receiving and dispatch'}</p>
                </div>
                <div>
                    <div class="flex items-baseline gap-2 mb-4 border-t border-slate-200 pt-4">
                        <span class="text-3xl md:text-4xl font-bold font-mono text-primary">$250.00</span>
                        <span class="text-slate-500 font-medium">{isEs ? 'Lun-Vie' : 'Mon-Fri'}</span>
                    </div>
                    <a href="#quote" class="w-full py-3 rounded-xl border-2 border-slate-200 hover:border-accent hover:bg-accent hover:text-white transition-colors font-bold flex items-center justify-center gap-2 group/btn">
                        {isEs ? 'Solicitar' : 'Request'} <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </div>

            <!-- Fila 2: Transload Same Day -->
            <div class="lg:col-span-3 md:col-span-1 h-full border border-slate-200 rounded-2xl p-5 md:p-6 bg-slate-50 hover:bg-white hover:shadow-xl transition-all duration-500 hover:-translate-y-1 relative overflow-hidden group/card flex flex-col justify-between reveal reveal-delay-100">
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="stencil-text text-accent">{isEs ? 'MANEJO' : 'HANDLING'}</span>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold mb-2 font-display">{isEs ? 'Transbordo Mismo Día' : 'Transload Same Day'}</h3>
                    <p class="text-slate-600 text-sm mb-4">{isEs ? 'Descarga y carga el mismo día' : 'Same-day unloading and loading'}</p>
                </div>
                <div>
                    <div class="flex items-baseline gap-2 mb-4 border-t border-slate-200 pt-4">
                        <span class="text-3xl md:text-4xl font-bold font-mono text-primary">$9.00</span>
                        <span class="text-slate-500 font-medium">/pallet</span>
                    </div>
                    <a href="#quote" class="w-full py-3 rounded-xl border-2 border-slate-200 hover:border-accent hover:bg-accent hover:text-white transition-colors font-bold flex items-center justify-center gap-2 group/btn">
                        {isEs ? 'Solicitar' : 'Request'} <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </div>

            <!-- Fila 2: Transload Next Day -->
            <div class="lg:col-span-3 md:col-span-1 h-full border border-slate-200 rounded-2xl p-5 md:p-6 bg-slate-50 hover:bg-white hover:shadow-xl transition-all duration-500 hover:-translate-y-1 relative overflow-hidden group/card flex flex-col justify-between reveal reveal-delay-200">
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <span class="stencil-text text-accent">{isEs ? 'MANEJO' : 'HANDLING'}</span>
                    </div>
                    <h3 class="text-xl md:text-2xl font-bold mb-2 font-display">{isEs ? 'Transbordo Día Siguiente' : 'Transload Next Day'}</h3>
                    <p class="text-slate-600 text-sm mb-4">{isEs ? 'Procesado para salida al día siguiente' : 'Processed for next-day departure'}</p>
                </div>
                <div>
                    <div class="flex items-baseline gap-2 mb-4 border-t border-slate-200 pt-4">
                        <span class="text-3xl md:text-4xl font-bold font-mono text-primary">$10.50</span>
                        <span class="text-slate-500 font-medium">/pallet</span>
                    </div>
                    <a href="#quote" class="w-full py-3 rounded-xl border-2 border-slate-200 hover:border-accent hover:bg-accent hover:text-white transition-colors font-bold flex items-center justify-center gap-2 group/btn">
                        {isEs ? 'Solicitar' : 'Request'} <span class="group-hover/btn:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>