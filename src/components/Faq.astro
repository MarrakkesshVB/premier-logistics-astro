---
interface Props {
  isEs?: boolean;
}
const { isEs = false } = Astro.props;

const faqs = [
  {
    q: isEs ? '¿Cuáles son sus horarios de operación?' : 'What are your operating hours?',
    a: isEs ? 'Horarios de operación flexibles. Contáctanos para agendar una reunión con un consultor logístico certificado.' : 'Flexible hours of operation. Contact us to schedule a meeting with a certified logistics consultant.',
  },
  {
    q: isEs ? '¿Dónde están ubicados?' : 'Where are you located?',
    a: isEs ? 'Nuestras instalaciones están ubicadas en Miami en: 3600 NW 114th Ave, Unit A, Doral, FL 33178.' : 'Our facility is strategically located in Miami at 3600 NW 114th Ave, Unit A, Doral, FL 33178.',
  },
  {
    q: isEs ? '¿Qué servicios logísticos ofrecen?' : 'What logistics services do you offer?',
    a: isEs ? 'Ofrecemos soluciones integrales: Almacenamiento a corto y largo plazo, Cross-Docking / Transload, procesamiento de pedidos, Full Truckload (FTL) / LTL, y Drayage de contenedores.' : 'We offer comprehensive solutions including short and long-term storage, Cross-Docking / Transload services, order fulfillment, Nationwide FTL/LTL, and Container Drayage.',
  },
  {
    q: isEs ? '¿Ofrecen despacho de aduanas?' : 'Do you offer customs clearance?',
    a: isEs ? 'Sí — para importadores, los cargos de despacho de aduana están exentos.' : 'Yes — for importers, Customs Clearance Fees are waived.',
  },
  {
    q: isEs ? '¿Cómo se protege mi carga?' : 'How is my cargo protected?',
    a: isEs ? 'Instalación certificada con seguridad 24/7 y cámaras en sitio. Empresa propiedad de mujeres con más de 25 años de experiencia combinada.' : 'Certified facility with 24/7 security and onsite cameras. Woman-owned business with over 25 years of combined experience.',
  },
  {
    q: isEs ? '¿Ofrecen contratos cortos o diarios?' : 'Do you offer short-term or daily contracts?',
    a: isEs ? 'Sí: contratos diarios y semanales disponibles. Tu cotización personalizada es confirmada por nuestro equipo.' : 'Yes: daily & weekly contracts available. Your custom quote is confirmed by our team.',
  },
];

// Schema FAQPage generado de la misma fuente que el UI (cero drift)
const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};
---

<section class="py-16 md:py-24 bg-slate-100" id="faq">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16 reveal">
            <span class="stencil-text text-accent mb-4 block">{isEs ? 'PREGUNTAS FRECUENTES' : 'FAQS'}</span>
            <h2 class="text-4xl md:text-5xl font-bold font-display">{isEs ? 'Preguntas Frecuentes' : 'Frequently Asked Questions'}</h2>
        </div>

        <div class="space-y-4">
            {faqs.map((f, i) => (
                <div class="faq-item rounded-2xl bg-slate-50 border border-transparent transition-all duration-300 overflow-hidden reveal">
                    <button type="button" id={`faq-btn-${i + 1}`} class="w-full flex items-center gap-4 p-5 md:p-6 text-left cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-accent" aria-expanded="false" aria-controls={`faq-panel-${i + 1}`}>
                        <span class="faq-num w-8 h-8 shrink-0 rounded-full bg-slate-200 text-slate-600 text-xs font-bold font-mono flex items-center justify-center transition-colors duration-300">{i + 1}</span>
                        <span class="flex-1 font-bold text-primary text-base md:text-lg">{f.q}</span>
                        <span class="faq-icon w-9 h-9 shrink-0 rounded-full bg-primary text-white flex items-center justify-center transition-all duration-300">
                            <i data-lucide="plus" class="w-4 h-4 transition-transform duration-300"></i>
                        </span>
                    </button>
                    <div id={`faq-panel-${i + 1}`} class="faq-panel" role="region" aria-labelledby={`faq-btn-${i + 1}`}>
                        <div class="min-h-0 overflow-hidden">
                            <p class="px-6 md:px-8 pb-6 md:pb-8 text-slate-600 text-sm md:text-base leading-relaxed">{f.a}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>

    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)}></script>

    <script>
        // Acordeón exclusivo: abrir una cierra las demás (como la referencia)
        const faqItems = Array.from(document.querySelectorAll('.faq-item'));
        faqItems.forEach((item) => {
            const btn = item.querySelector('button') as HTMLButtonElement | null;
            if (!btn) return;
            btn.addEventListener('click', () => {
                const wasOpen = item.classList.contains('is-open');
                faqItems.forEach((other) => {
                    other.classList.remove('is-open');
                    const otherBtn = other.querySelector('button') as HTMLButtonElement | null;
                    if (otherBtn) otherBtn.setAttribute('aria-expanded', 'false');
                });
                if (!wasOpen) {
                    item.classList.add('is-open');
                    btn.setAttribute('aria-expanded', 'true');
                }
            });
        });
    </script>
</section>