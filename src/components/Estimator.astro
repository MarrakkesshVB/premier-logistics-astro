---
interface Props {
  isEs?: boolean;
}
const { isEs = false } = Astro.props;
---

<section id="estimator" class="py-16 md:py-24 bg-gradient-to-b from-white to-slate-100 text-primary overflow-hidden relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
            <div class="reveal">
                <div class="flex items-center gap-3 mb-6 text-accent">
                    <i data-lucide="calculator" class="w-6 h-6"></i>
                    <span class="stencil-text">{isEs ? 'Estimador de Costos' : 'Cost Estimator'}</span>
                </div>
                <h2 class="text-4xl md:text-5xl font-bold mb-6 font-display">{isEs ? 'Calcula tu inversión al instante' : 'Calculate your investment instantly'}</h2>
                <p class="text-base md:text-lg text-slate-600 mb-10">
                    {isEs ? 'Calcula tu costo al instante con las tarifas publicadas de nuestro Rate Board.' : 'Calculate your cost instantly from our published Rate Board.'}
                </p>

                <div class="lg:min-h-[560px]">
                <div class="space-y-8 bg-white border border-slate-200 shadow-xl p-6 md:p-8 rounded-2xl">
                    <div id="service-picker" class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                        <button type="button" data-service="storage" class="est-svc px-2 py-2 text-xs font-bold rounded-md bg-accent text-white" aria-pressed="true">{isEs ? 'Almacenaje' : 'Storage'}</button>
                        <button type="button" data-service="pickpack" class="est-svc px-2 py-2 text-xs font-bold rounded-md bg-slate-100 text-slate-600" aria-pressed="false">Pick & Pack</button>
                        <button type="button" data-service="transload" class="est-svc px-2 py-2 text-xs font-bold rounded-md bg-slate-100 text-slate-600" aria-pressed="false">Transload</button>
                        <button type="button" data-service="crossdock" class="est-svc px-2 py-2 text-xs font-bold rounded-md bg-slate-100 text-slate-600" aria-pressed="false">Cross Dock</button>
                    </div>

                    <div id="block-pallets">
                        <div class="flex justify-between mb-2">
                            <label class="font-bold text-sm uppercase tracking-wider text-slate-700">{isEs ? 'Número de Pallets' : 'Number of Pallets'}</label>
                            <span class="font-mono font-bold text-accent" id="pallets-val">10</span>
                        </div>
                        <input type="range" id="pallets" min="1" max="100" value="10" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-accent" />
                    </div>

                    <div id="block-duration">
                        <div class="flex justify-between items-center mb-2">
                            <label class="font-bold text-sm uppercase tracking-wider text-slate-700">{isEs ? 'Duración' : 'Duration'}</label>
                            <div class="flex items-center gap-2">
                                <div class="flex rounded-md overflow-hidden border border-slate-300">
                                    <button type="button" id="unit-months" class="px-2 py-1 text-xs font-bold bg-accent text-white">{isEs ? 'Meses' : 'Months'}</button>
                                    <button type="button" id="unit-days" class="px-2 py-1 text-xs font-bold bg-slate-100 text-slate-600">{isEs ? 'Días' : 'Days'}</button>
                                </div>
                                <span class="font-mono font-bold text-accent" id="months-val">1</span>
                            </div>
                        </div>
                        <input type="range" id="months" min="1" max="12" value="1" class="w-full h-2 bg-slate-200 rounded-lg appearance-none cursor-pointer accent-accent" />
                        <p id="duration-note" class="hidden text-xs text-slate-500 mt-2">{isEs ? 'Contratos diarios y semanales disponibles — cotización personalizada confirmada por nuestro equipo.' : 'Daily & weekly contracts available — custom quote confirmed by our team.'}</p>
                    </div>

                    <div id="block-turnaround" class="hidden">
                        <label class="font-bold text-sm uppercase tracking-wider text-slate-700 block mb-2">{isEs ? 'Tiempo de Entrega' : 'Turnaround'}</label>
                        <div class="flex rounded-md overflow-hidden border border-slate-300 w-fit">
                            <button type="button" id="est-same" class="px-3 py-1.5 text-xs font-bold bg-accent text-white" aria-pressed="true">{isEs ? 'Mismo Día ($9.00)' : 'Same Day ($9.00)'}</button>
                            <button type="button" id="est-next" class="px-3 py-1.5 text-xs font-bold bg-slate-100 text-slate-600" aria-pressed="false">{isEs ? 'Día Siguiente ($10.50)' : 'Next Day ($10.50)'}</button>
                        </div>
                    </div>

                    <div class="pt-6 border-t border-white/10">
                        <span class="text-slate-500 text-sm font-bold uppercase tracking-wider mb-2 block">{isEs ? 'Costo Estimado' : 'Estimated Cost'}</span>
                        <div id="estimate-monthly">
                            <div class="flex items-baseline gap-2">
                                <span class="text-4xl text-slate-500 font-light">$</span>
                                <span id="total-cost" class="text-5xl md:text-6xl font-bold font-mono tracking-tighter text-primary">150.00</span>
                            </div>
                            <p class="text-xs text-emerald-400 font-bold mt-2 bg-emerald-400/10 inline-block px-2 py-1 rounded">{isEs ? 'Basado en el Rate Board publicado' : 'Based on published Rate Board'}</p>
                        </div>
                        <div id="estimate-daily" class="hidden">
                            <p class="text-slate-600 text-sm font-medium">{isEs ? 'Tu cotización personalizada está a un clic: sin números inventados, confirmada por nuestro equipo.' : 'Your custom quote is one click away — no invented numbers, confirmed by our team.'}</p>
                            <a href="#quote" class="mt-3 inline-flex items-center gap-2 bg-accent hover:bg-accent-dark text-white px-5 py-3 rounded-xl font-bold transition-all btn-glow">{isEs ? 'Solicitar cotización personalizada' : 'Get my custom quote'} <span>→</span></a>
                        </div>
                        <p class="text-xs text-slate-500 mt-3">{isEs ? 'Tarifa de referencia sujeta a variación — cotización final confirmada por nuestro equipo.' : 'Reference rate subject to change — final quote confirmed by our team.'}</p>
                    </div>
                </div>
                </div>
            </div>

            <div class="relative h-[400px] md:h-[600px] lg:translate-y-20 rounded-3xl bg-white border border-slate-200 overflow-hidden flex items-center justify-center p-8 reveal">
                <div class="absolute inset-0 bg-[linear-gradient(to_right,#0f172a08_1px,transparent_1px),linear-gradient(to_bottom,#0f172a08_1px,transparent_1px)] bg-[size:40px_40px]"></div>
                <div class="iso-scene relative z-10 w-full h-full">
                    <div id="pallet-stack" class="iso-grid"></div>
                </div>
                <div id="pallet-overflow" class="hidden absolute bottom-8 left-1/2 -translate-x-1/2 bg-slate-900/80 backdrop-blur-sm text-white px-4 py-2 rounded-full text-sm font-bold z-10"></div>
                <div class="absolute bottom-4 w-[80%] h-4 bg-slate-300 rounded-full blur-xl z-0 pointer-events-none"></div>
            </div>
        </div>
    </div>
</section>